    {
      "parameters": {
        "jsCode": "const entrada =\n  $('recibir_solicitud_paciente_dz')\n    .first()\n    .json;\n\nconst contactIdTexto =\n  String(\n    entrada.contact_id ?? ''\n  ).trim();\n\nlet contactId = null;\n\nif (contactIdTexto !== '') {\n  const valor =\n    Number(\n      entrada.contact_id\n    );\n\n  if (\n    !Number.isSafeInteger(valor) ||\n    valor <= 0\n  ) {\n    throw new Error(\n      'DZ_PACIENTE_CONTACT_ID_INVALIDO'\n    );\n  }\n\n  contactId = valor;\n}\n\nconst nombrePaciente =\n  String(\n    entrada.nombre_paciente ?? ''\n  ).trim();\n\nif (nombrePaciente === '') {\n  throw new Error(\n    'DZ_PACIENTE_NOMBRE_REQUERIDO'\n  );\n}\n\nconst telefonoOriginal =\n  String(\n    entrada.telefono ?? ''\n  ).trim();\n\nif (telefonoOriginal === '') {\n  throw new Error(\n    'DZ_PACIENTE_TELEFONO_REQUERIDO'\n  );\n}\n\nlet digitos =\n  telefonoOriginal.replace(\n    /\\D/g,\n    ''\n  );\n\nif (digitos.length === 8) {\n  digitos =\n    `502${digitos}`;\n}\n\nif (\n  digitos.length !== 11 ||\n  !digitos.startsWith('502')\n) {\n  throw new Error(\n    'DZ_PACIENTE_TELEFONO_INVALIDO'\n  );\n}\n\nreturn [\n  {\n    json: {\n      contact_id:\n        contactId,\n\n      nombre_paciente:\n        nombrePaciente,\n\n      telefono:\n        `+${digitos}`,\n\n      calificacion_cliente:\n        10,\n\n      paciente_activo:\n        true,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

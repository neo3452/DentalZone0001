      "parameters": {
        "jsCode": "const paciente = $input.first().json;\n\nconst id = Number(paciente.id);\n\nif (!Number.isInteger(id) || id <= 0) {\n  throw new Error('DZ_PACIENTE_ID_INTERNO_INVALIDO');\n}\n\nreturn [\n  {\n    json: {\n      ...paciente,\n      paciente_id: `DZ-${String(id).padStart(6, '0')}`,\n    },\n  },\n];"

    {
      "parameters": {
        "jsCode": "const entrada = $input.first()?.json ?? {};\n\nif (\n  !Number.isSafeInteger(Number(entrada.id)) ||\n  Number(entrada.id) <= 0\n) {\n  throw new Error(\n    'DZ_DESTINATARIO_SECRETARIA_CLINICA_NO_ENCONTRADO'\n  );\n}\n\nfor (const campo of [\n  'clinica_id',\n  'nombre_clinica',\n  'telefono_whatsapp',\n]) {\n  if (\n    typeof entrada[campo] !== 'string' ||\n    entrada[campo].trim() === ''\n  ) {\n    throw new Error(\n      `DZ_DESTINATARIO_SECRETARIA_CLINICA_INVALIDO: ${campo}`\n    );\n  }\n}\n\nif (\n  !/^\\+[1-9]\\d{7,14}$/.test(\n    entrada.telefono_whatsapp.trim()\n  )\n) {\n  throw new Error(\n    'DZ_DESTINATARIO_SECRETARIA_CLINICA_INVALIDO: telefono_whatsapp'\n  );\n}\n\n\n\nif (entrada.clinica_activa !== true) {\n  throw new Error(\n    'DZ_TRANSFERENCIA_SECRETARIA_NO_AUTORIZADA: clinica_inactiva'\n  );\n}\n\n\n\n\nif (entrada.agenda_sofia_activa !== false) {\n  throw new Error(\n    'DZ_TRANSFERENCIA_SECRETARIA_NO_AUTORIZADA: agenda_sofia_activa'\n  );\n}\n\nreturn [\n  {\n    json: entrada,\n  },\n];"
      },

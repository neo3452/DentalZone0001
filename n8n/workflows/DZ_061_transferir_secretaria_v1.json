      "id": "f5842fcf-bb28-4658-8569-c6dcf624ffbb",
      "name": "validar_notificacion_transferencia_dz"
    },
    {
      "parameters": {
        "jsCode": "const entrada =\n  $('validar_contrato_transferencia_cita_secretaria_dz')\n    .first()\n    .json;\n\nconst estado =\n  $('persistir_transferencia_dz')\n    .first()\n    .json;\n\nconst resultadoNotificaciones =\n  $input.first()?.json ?? {};\n\nconst messageIdCliente =\n  Number(resultadoNotificaciones.id);\n\nif (\n  !Number.isSafeInteger(messageIdCliente) ||\n  messageIdCliente <= 0\n) {\n  throw new Error(\n    'DZ_TRANSFERENCIA_CITA_SIN_MESSAGE_ID_CLIENTE'\n  );\n}\n\nconst mensajeTransporteSecretariaId =\n  String(\n    resultadoNotificaciones\n      .mensaje_transporte_id ?? ''\n  ).trim();\n\nif (mensajeTransporteSecretariaId === '') {\n  throw new Error(\n    'DZ_TRANSFERENCIA_CITA_SIN_IDENTIFICADOR_SECRETARIA'\n  );\n}\n\nif (\n  resultadoNotificaciones\n    .notificacion_secretaria_aceptada !== true\n) {\n  throw new Error(\n    'DZ_TRANSFERENCIA_CITA_SECRETARIA_NO_ACEPTADA'\n  );\n}\n\nconst estadoTransporteSecretaria =\n  String(\n    resultadoNotificaciones\n      .estado_transporte ?? ''\n  ).trim();\n\nreturn [\n  {\n    json: {\n      ...entrada,\n      transferencia: {\n        completada: true,\n        bloqueo_chatwoot: true,\n        estado_sofia:\n          estado.estado_sofia,\n        motivo_transferencia:\n          estado.motivo_transferencia,\n        message_id_cliente:\n          messageIdCliente,\n        mensaje_transporte_secretaria_id:\n          mensajeTransporteSecretariaId,\n        estado_transporte_secretaria:\n          estadoTransporteSecretaria,\n        notificacion_secretaria_aceptada:\n          true,\n      },\n    },\n  },\n];"
      },

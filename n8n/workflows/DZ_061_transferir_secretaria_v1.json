    },
    {
      "parameters": {
        "jsCode": "const entrada = $input.first()?.json ?? {};\n\nfor (const campo of [\n  'account_id',\n  'chatwoot_id',\n  'contact_id',\n  'inbox_id',\n  'message_id',\n]) {\n  if (\n    !Number.isSafeInteger(entrada[campo]) ||\n    entrada[campo] <= 0\n  ) {\n    throw new Error(\n      `DZ_CONTRATO_TRANSFERENCIA_CITA_INVALIDO: ${campo}`\n    );\n  }\n}\n\nfor (const campo of [\n  'conversation_id',\n  'nombre_cliente',\n  'telefono_cliente',\n  'texto_consolidado',\n  'fecha_evento',\n  'motivo_transferencia',\n  'clinica_id',\n]) {\n  if (\n    typeof entrada[campo] !== 'string' ||\n    entrada[campo].trim() === ''\n  ) {\n    throw new Error(\n      `DZ_CONTRATO_TRANSFERENCIA_CITA_INVALIDO: ${campo}`\n    );\n  }\n}\n\nif (Number.isNaN(Date.parse(entrada.fecha_evento))) {\n  throw new Error(\n    'DZ_CONTRATO_TRANSFERENCIA_CITA_INVALIDO: fecha_evento'\n  );\n}\n\nif (\n  entrada.motivo_transferencia !==\n  'agenda_sofia_inactiva'\n) {\n  throw new Error(\n    'DZ_MOTIVO_TRANSFERENCIA_CITA_NO_AUTORIZADO'\n  );\n}\n\nif (typeof entrada.primera_visita !== 'boolean') {\n  throw new Error(\n    'DZ_CONTRATO_TRANSFERENCIA_CITA_INVALIDO: primera_visita'\n  );\n}\n\nif (\n  typeof entrada.mensaje_cliente !== 'string' ||\n  entrada.mensaje_cliente.trim() === ''\n) {\n  throw new Error(\n    'DZ_CONTRATO_TRANSFERENCIA_CITA_INVALIDO: mensaje_cliente'\n  );\n}\n\nreturn [\n  {\n    json: entrada,\n  },\n];"
      },

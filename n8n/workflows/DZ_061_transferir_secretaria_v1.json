    },
    {
      "parameters": {
        "jsCode": "const entrada =\n  $('validar_destinatario_secretaria_clinica_dz')\n    .first()\n    .json;\n\nconst primeraVisitaTexto =\n  entrada.primera_visita === true\n    ? 'Sí'\n    : 'No';\n\nconst mensajeSecretaria = [\n  '📌 Solicitud de cita para Secretaría',\n  '',\n  `Paciente: ${entrada.nombre_cliente}`,\n  `Teléfono: ${entrada.telefono_cliente}`,\n  `Clínica: ${entrada.nombre_clinica}`,\n  `Primera visita: ${primeraVisitaTexto}`,\n  `Chatwoot ID: ${entrada.chatwoot_id}`,\n  `Mensaje recibido: ${entrada.texto_consolidado}`,\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      ...entrada,\n      telefono_secretaria:\n        entrada.telefono_whatsapp,\n      mensaje_secretaria:\n        mensajeSecretaria,\n    },\n  },\n];"
      },

    {
      "parameters": {
        "jsCode": "const respuesta = $input.first()?.json ?? {};\n\nconst contenidoEsperado =\n  $('validar_contrato_transferencia_cita_secretaria_dz')\n    .first()\n    .json\n    .mensaje_cliente;\n\nif (\n  !Number.isSafeInteger(respuesta.id) ||\n  respuesta.id <= 0\n) {\n  throw new Error(\n    'DZ_NOTIFICACION_TRANSFERENCIA_SIN_MESSAGE_ID'\n  );\n}\n\nif (Number(respuesta.message_type) !== 1) {\n  throw new Error(\n    'DZ_NOTIFICACION_TRANSFERENCIA_NO_SALIENTE'\n  );\n}\n\nif (respuesta.content !== contenidoEsperado) {\n  throw new Error(\n    'DZ_NOTIFICACION_TRANSFERENCIA_CONTENIDO_INVALIDO'\n  );\n}\n\nreturn [{ json: respuesta }];"
      },

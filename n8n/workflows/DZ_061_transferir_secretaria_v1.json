        "jsonBody": "={{\n  {\n    content:\n      $('validar_contrato_transferencia_cita_secretaria_dz')\n        .first()\n        .json\n        .mensaje_cliente,\n    message_type: 'outgoing',\n    private: false\n  }\n}}",
